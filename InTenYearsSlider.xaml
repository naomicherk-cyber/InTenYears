<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InTenYears.InTenYearsSlider"
             Title="InTenYearsSlider">
    <Grid RowDefinitions="*,*" Margin="10">
        <Label TextColor="Black"  Text="lala" Grid.Row="0" x:Name="xyz"/>
        <VerticalStackLayout  Spacing="10" Grid.Row="1" VerticalOptions="End">
            <Label Text="Your Name"/>
            <Entry x:Name="entryName"/>
            <Label Text="Your age"/>
            <Grid ColumnDefinitions="*,50">

                <Slider Grid.Column="0"
                  Minimum="0"
                  Maximum="120" 
                  ValueChanged="sliderAge_ValueChanged"
                  DragCompleted="sliderAge_DragCompleted"
                  x:Name="sliderAge"/>
                <Entry x:Name="entryAge" Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>